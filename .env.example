# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file with real secrets to git.

# Supabase (used by all ingestion/analysis scripts via the Python client)
SUPABASE_URL=
SUPABASE_KEY=

# FRED API (Federal Reserve Economic Data) - free key from
# https://fred.stlouisfed.org/docs/api/api_key.html
# Used by scripts/ingest_fred_macro_data.py
FRED_API_KEY=

# Market price data
TWELVE_DATA_API_KEY=

# Not currently used in active ingestion (kept for reference /
# possible future use)
ALPHAVANTAGE_API_KEY=
